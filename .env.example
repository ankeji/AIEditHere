# ===== MySQL =====
# 本地 MySQL 连接信息，启动时会自动创建数据库和表
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# 请填写你本机 MySQL 的密码；没有密码则留空
MYSQL_PASSWORD=
MYSQL_DATABASE=aiedithere

# ===== 登录会话 =====
# 生产环境请改成随机长字符串
AUTH_SECRET=aiedithere-local-dev-secret
# 登录有效期（天）
AUTH_SESSION_DAYS=14
# 验证码有效期（分钟）
AUTH_CODE_TTL_MINUTES=10
# 同一邮箱两次获取验证码的最小间隔（秒）
AUTH_CODE_COOLDOWN_SECONDS=60
# 未配置 SMTP 时，是否允许把验证码返回给前端方便本地调试
AUTH_ALLOW_DEV_CODE=1
# 使用 HTTPS 时设为 1，让登录 Cookie 只走安全连接
AUTH_COOKIE_SECURE=0

# ===== 邮箱 SMTP =====
# 不配置 SMTP 时，验证码会打印在服务端控制台，并返回给本地登录页
# QQ 邮箱示例：smtp.qq.com / 465 / 使用授权码作为密码
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
